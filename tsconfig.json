{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "strict": false,
    "noImplicitAny": false,
    "noEmit": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*.js", "src/**/*.d.ts", "tests/**/*.js"]
}
